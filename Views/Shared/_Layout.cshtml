@using System.Security.Claims
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - YLG (You Learn Geometry)</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <span>YLG</span>
                    <span class="text-primary fs-6 fw-normal ms-1">Geometry</span>
                </a>
                
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Tổng quan</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Curriculum" asp-action="Index">Bài học</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="KnowledgeMap" asp-action="Index">Bản đồ tri thức</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="GeometryLab" asp-action="Index">Geometry Lab</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PropertyBuilder" asp-action="Index">Property Builder</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="RealWorld" asp-action="Index">Thực tế</a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-danger fw-semibold" asp-controller="Admin" asp-action="Index">Quản trị</a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var grade = User.FindFirstValue("GradeLevel") ?? "Lop6";
                            var gradeLabel = grade switch
                            {
                                "Lop6" => "Lớp 6",
                                "Lop7" => "Lớp 7",
                                "Lop8" => "Lớp 8",
                                "Lop9" => "Lớp 9",
                                _ => "Lớp 6"
                            };

                            <!-- Grade Switcher -->
                            <li class="nav-item dropdown">
                                <button class="btn btn-sm btn-light border dropdown-toggle fw-semibold rounded-pill px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @gradeLabel
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li><h6 class="dropdown-header">Chọn cấp độ học</h6></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="UpdateGrade" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="gradeLevel" value="Lop6" />
                                            <button type="submit" class="dropdown-item @(grade == "Lop6" ? "active" : "")">
                                                Lớp 6 (Hình phẳng trực quan)
                                            </button>
                                        </form>
                                    </li>
                                    <li>
                                        <form asp-controller="Account" asp-action="UpdateGrade" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="gradeLevel" value="Lop7" />
                                            <button type="submit" class="dropdown-item @(grade == "Lop7" ? "active" : "")">
                                                Lớp 7 (Góc & Tam giác)
                                            </button>
                                        </form>
                                    </li>
                                    <li>
                                        <form asp-controller="Account" asp-action="UpdateGrade" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="gradeLevel" value="Lop8" />
                                            <button type="submit" class="dropdown-item @(grade == "Lop8" ? "active" : "")">
                                                Lớp 8 (Tứ giác & Định lý suy luận)
                                            </button>
                                        </form>
                                    </li>
                                    <li>
                                        <form asp-controller="Account" asp-action="UpdateGrade" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="gradeLevel" value="Lop9" />
                                            <button type="submit" class="dropdown-item @(grade == "Lop9" ? "active" : "")">
                                                Lớp 9 (Hệ thức lượng & Đường tròn)
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>

                            <!-- User Profile Dropdown -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                        @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                    <span class="fw-semibold">@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                            Hồ sơ cá nhân
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-primary fw-semibold px-3" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-ylg-primary px-3" asp-controller="Account" asp-action="Register">Đăng ký học ngay</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="@(ViewData["FluidLayout"] as bool? == true ? "container-fluid p-0" : "container py-4") flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="@(ViewData["FluidLayout"] as bool? == true ? "container pt-3" : "")">
                <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="@(ViewData["FluidLayout"] as bool? == true ? "container pt-3" : "")">
                <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="@(ViewData["FluidLayout"] as bool? == true ? "container pt-3" : "")">
                <div class="alert alert-info alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
                    <div>@TempData["InfoMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <div>
                <strong>YLG (You Learn Geometry)</strong> &copy; 2026 - Nền tảng học hình học phẳng trực quan
            </div>
            <div class="text-muted small">
                <span>Khoa Công nghệ Thông tin - HUIT</span> &bull; 
                <span>Nguyễn Kim Long</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
