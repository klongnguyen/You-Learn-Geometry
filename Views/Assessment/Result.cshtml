@model YouLearnGeometry.ViewModels.TestResultViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="row justify-content-center py-4">
    <div class="col-md-7 col-lg-6">
        <div class="ylg-card p-4 p-md-5 text-center shadow-lg">
            <div class="mb-4">
                @if (Model.IsPassed)
                {
                    <h3 class="fw-extrabold text-success mb-1">Kết quả: Đạt yêu cầu</h3>
                    <p class="text-muted small">Bạn đã vượt qua ngưỡng yêu cầu (@Model.Threshold%).</p>
                }
                else
                {
                    <h3 class="fw-extrabold text-danger mb-1">Kết quả: Chưa đạt yêu cầu</h3>
                    <p class="text-muted small">Cần đạt từ @Model.Threshold% trở lên. Bạn có thể ôn tập lại lý thuyết và làm lại bất cứ lúc nào.</p>
                }
            </div>

            <div class="p-4 bg-light rounded-4 mb-4 border">
                <span class="text-muted small d-block mb-1">Điểm số bài kiểm tra</span>
                <div class="display-3 fw-extrabold @(Model.IsPassed ? "text-success" : "text-danger") mb-2">
                    @Model.Score<span class="fs-4">%</span>
                </div>
                <div class="text-dark fw-semibold">
                    Đúng @Model.CorrectCount / @Model.TotalQuestions câu hỏi
                </div>
            </div>

            <!-- Badges Awarded -->
            @if (Model.NewBadgesEarned.Any())
            {
                <div class="p-3 bg-warning bg-opacity-10 border border-warning-subtle rounded-3 mb-4 text-start">
                    <strong class="text-dark d-block mb-2">
                        Mở khóa huy hiệu mới:
                    </strong>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var badge in Model.NewBadgesEarned)
                        {
                            var badgeName = badge switch
                            {
                                "khoi_dau" => "Khởi đầu nan (Hoàn thành bài đầu tiên)",
                                "ben_bi" => "Chiến binh bền bỉ (Streak 3 ngày)",
                                "bac_thay_tu_giac" => "Bậc thầy Tứ giác (Test ≥ 80%)",
                                _ => badge
                            };
                            <span class="badge bg-warning text-dark px-3 py-2 fs-6 rounded-pill">
                                @badgeName
                            </span>
                        }
                    </div>
                </div>
            }

            <div class="d-flex justify-content-center gap-3">
                <a href="@Model.BackUrl" class="btn btn-ylg-primary px-4 py-2">
                    Tiếp tục học tập
                </a>
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                    Về Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
