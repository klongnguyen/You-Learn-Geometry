@model YouLearnGeometry.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Student Dashboard";
    var gradeName = Model.User.GradeLevel == "Lop6" ? "Lớp 6 (Hình phẳng trực quan)" : "Lớp 8 (Tứ giác & Chứng minh)";
}

<!-- Welcome & Continue Learning Banner -->
<div class="hero-banner mb-4">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-light text-dark px-3 py-1 rounded-pill fw-bold">
                    <i class="bi bi-mortarboard-fill text-primary me-1"></i> @gradeName
                </span>
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold">
                    <i class="bi bi-fire text-danger me-1"></i> Streak: @Model.User.StreakCount ngày
                </span>
            </div>
            <h2 class="fw-bold mb-2">Xin chào, @Model.User.FullName! 👋</h2>
            <p class="text-white-50 mb-4">
                Hãy tiếp tục rèn luyện tư duy không gian và khám phá các tính chất hình học thú vị hôm nay.
            </p>

            @if (Model.NextLesson != null)
            {
                <div class="d-flex flex-wrap align-items-center gap-3">
                    <a asp-controller="Lesson" asp-action="Detail" asp-route-id="@Model.NextLesson.Id" class="btn btn-warning btn-lg fw-bold text-dark px-4 shadow">
                        <i class="bi bi-play-circle-fill me-2"></i> Tiếp tục học: @Model.NextLesson.Title
                    </a>
                    <span class="text-white-50 small">
                        Trạng thái: 
                        <span class="badge bg-white-50 text-white">
                            @(Model.NextLessonStatus == "Completed" ? "Đã xong (Ôn tập)" : (Model.NextLessonStatus == "AwaitingTest" ? "Chờ làm Mini Test" : "Đang học"))
                        </span>
                    </span>
                </div>
            }
        </div>
        <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
            <div class="bg-white bg-opacity-10 p-3 rounded-4 backdrop-blur d-inline-block text-start w-100" style="max-width: 320px;">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <small class="text-white-50">Tiến độ cấp độ</small>
                    <strong class="text-white">@Model.ProgressPercentage%</strong>
                </div>
                <div class="progress bg-white bg-opacity-20 mb-3" style="height: 10px;">
                    <div class="progress-bar bg-warning" role="progressbar" style="width: @Model.ProgressPercentage%;" aria-valuenow="@Model.ProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <div class="row g-2 text-center text-white small">
                    <div class="col-6">
                        <div class="p-2 rounded bg-black bg-opacity-20">
                            <span class="d-block fw-bold fs-5">@Model.CompletedLessonsCount / @Model.TotalLessonsInGrade</span>
                            <span class="text-white-50" style="font-size: 0.75rem;">Bài hoàn thành</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 rounded bg-black bg-opacity-20">
                            <span class="d-block fw-bold fs-5">@Model.CompletedTestsCount</span>
                            <span class="text-white-50" style="font-size: 0.75rem;">Bài test đã qua</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Content Grid -->
<div class="row g-4">
    <!-- Left Column: Lessons list -->
    <div class="col-lg-8">
        <div class="ylg-card p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-collection text-primary me-2"></i> Lộ trình bài học khuyến nghị
                </h5>
                <a asp-controller="Curriculum" asp-action="Index" class="btn btn-sm btn-outline-primary">
                    Xem toàn bộ chủ đề & Test <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <div class="list-group list-group-flush">
                @foreach (var item in Model.LessonItems)
                {
                    <div class="list-group-item px-0 py-3 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                        <div class="d-flex align-items-start gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5 flex-shrink-0 @(item.Progress?.Status == "Completed" ? "bg-success text-white" : "bg-light text-primary border")" style="width: 44px; height: 44px;">
                                @if (item.Progress?.Status == "Completed")
                                {
                                    <i class="bi bi-check-lg"></i>
                                }
                                else
                                {
                                    <span>@item.Lesson.Order</span>
                                }
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-dark">@item.Lesson.Title</h6>
                                <p class="text-muted small mb-1">@item.Lesson.Summary</p>
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="badge @item.StatusBadgeClass badge-status">
                                        @item.StatusText
                                    </span>
                                    @if (item.Lesson.HasGeometryLab)
                                    {
                                        <span class="badge bg-primary-subtle text-primary" style="font-size: 0.75rem;">
                                            <i class="bi bi-bounding-box me-1"></i> Có Lab tương tác
                                        </span>
                                    }
                                    @if (item.Progress?.BestMiniTestScore > 0)
                                    {
                                        <span class="badge bg-light text-dark border" style="font-size: 0.75rem;">
                                            Điểm cao nhất: <strong>@item.Progress.BestMiniTestScore%</strong>
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="flex-shrink-0 text-end">
                            <a asp-controller="Lesson" asp-action="Detail" asp-route-id="@item.Lesson.Id" class="btn btn-sm @(item.Progress?.Status == "Completed" ? "btn-outline-secondary" : "btn-ylg-primary") px-3">
                                @(item.Progress?.Status == "Completed" ? "Xem lại bài" : "Học bài ngay")
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Achievements & Quick Actions -->
    <div class="col-lg-4">
        <!-- Achievements Card -->
        <div class="ylg-card p-4 mb-4">
            <h5 class="fw-bold mb-3 text-dark">
                <i class="bi bi-award text-warning me-2"></i> Huy hiệu đạt được
            </h5>
            <div class="d-flex flex-column gap-3">
                @foreach (var badge in Model.Badges)
                {
                    bool isEarned = (Model.User.BadgesEarned ?? new List<string>()).Contains(badge.Code);
                    <div class="p-3 rounded-3 border d-flex align-items-center gap-3 @(isEarned ? "bg-warning bg-opacity-10 border-warning-subtle" : "bg-light opacity-50")">
                        <div class="fs-2 flex-shrink-0">@badge.Icon</div>
                        <div>
                            <strong class="d-block text-dark small">@badge.Title</strong>
                            <small class="text-muted">@badge.Description</small>
                            @if (isEarned)
                            {
                                <span class="badge bg-success-subtle text-success mt-1 d-inline-block" style="font-size: 0.65rem;">
                                    <i class="bi bi-check-circle-fill me-1"></i> Đã mở khóa
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Quick Access -->
        <div class="ylg-card p-4">
            <h5 class="fw-bold mb-3 text-dark">
                <i class="bi bi-compass text-primary me-2"></i> Công cụ học tập
            </h5>
            <div class="d-grid gap-2">
                <a asp-controller="KnowledgeMap" asp-action="Index" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-3">
                    <div>
                        <strong class="d-block text-dark">Bản đồ tri thức Neo4j</strong>
                        <small class="text-muted">Khám phá sơ đồ kế thừa tính chất</small>
                    </div>
                    <i class="bi bi-diagram-3 text-primary fs-5"></i>
                </a>
                <a asp-controller="PropertyBuilder" asp-action="Index" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-3">
                    <div>
                        <strong class="d-block text-dark">Property Builder</strong>
                        <small class="text-muted">Tích chọn tính chất & suy luận hình</small>
                    </div>
                    <i class="bi bi-check2-square text-success fs-5"></i>
                </a>
                <a asp-controller="GeometryLab" asp-action="Index" class="btn btn-light border text-start d-flex align-items-center justify-content-between p-3">
                    <div>
                        <strong class="d-block text-dark">Geometry Lab</strong>
                        <small class="text-muted">Kéo đỉnh & Thử thách Challenge Mode</small>
                    </div>
                    <i class="bi bi-bounding-box text-purple fs-5" style="color:#7c3aed;"></i>
                </a>
            </div>
        </div>
    </div>
</div>
