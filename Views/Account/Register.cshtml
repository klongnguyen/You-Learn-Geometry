@model YouLearnGeometry.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản học sinh";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5">
        <div class="ylg-card p-4 p-md-5 shadow-lg">
            <div class="text-center mb-4">
                <div class="rounded-circle bg-success-subtle text-success d-inline-flex align-items-center justify-content-center mb-2" style="width: 56px; height: 56px;">
                    <i class="bi bi-person-plus-fill fs-3"></i>
                </div>
                <h3 class="fw-bold text-dark">Tạo tài khoản mới</h3>
                <p class="text-muted small">Bắt đầu học hình học theo đúng chương trình và cấp độ của bạn.</p>
            </div>

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold small text-muted"></label>
                    <input asp-for="FullName" class="form-control" placeholder="Ví dụ: Nguyễn Văn An" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Username" class="form-label fw-semibold small text-muted"></label>
                        <input asp-for="Username" class="form-control" placeholder="vanan123" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Email" class="form-label fw-semibold small text-muted"></label>
                        <input asp-for="Email" class="form-control" placeholder="vanan@gmail.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold small text-muted"></label>
                    <input asp-for="Password" class="form-control" placeholder="Mật khẩu của bạn" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="GradeLevel" class="form-label fw-semibold small text-muted"></label>
                    <select asp-for="GradeLevel" class="form-select border-primary-subtle">
                        <option value="Lop6">Lớp 6 - Nhận biết hình phẳng thực tiễn (Cạnh, góc, chu vi, diện tích)</option>
                        <option value="Lop7">Lớp 7 - Góc & Tam giác (Góc song song, tam giác bằng nhau, tam giác cân)</option>
                        <option value="Lop8">Lớp 8 - Tứ giác & Định lí hình học (Thalès, Pythagore, chứng minh)</option>
                        <option value="Lop9">Lớp 9 - Hệ thức lượng & Đường tròn (Lượng giác, tiếp tuyến, góc nội tiếp)</option>
                    </select>
                    <span asp-validation-for="GradeLevel" class="text-danger small"></span>
                    <small class="text-muted mt-1 d-block">Bạn có thể thay đổi lại cấp độ học bất kỳ lúc nào trong Hồ sơ.</small>
                </div>

                <button type="submit" class="btn btn-ylg-primary w-100 py-2 fs-6 mb-3">
                    Đăng ký & Bắt đầu học <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </form>

            <div class="border-top pt-3 text-center small text-muted">
                Đã có tài khoản? <a asp-action="Login" class="text-primary fw-semibold">Đăng nhập ngay</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
