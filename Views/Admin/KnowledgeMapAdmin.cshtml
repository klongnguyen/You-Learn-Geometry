@model List<YouLearnGeometry.Models.GraphNode>
@{
    ViewData["Title"] = "Quản lý Neo4j Knowledge Graph";
    var rels = ViewBag.Relationships as List<YouLearnGeometry.Models.GraphRelationship> ?? new List<YouLearnGeometry.Models.GraphRelationship>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark">
            <i class="bi bi-diagram-3-fill text-success me-2"></i> Quản trị Tri thức Neo4j (Graph Database)
        </h3>
        <p class="text-muted mb-0">Thêm, sửa, xóa các Node và Mối liên hệ quan hệ kế thừa trên Neo4j Aura.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="KnowledgeMap" asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-eye me-1"></i> Xem đồ thị Cytoscape
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Dashboard Admin
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Form Add/Update Node -->
    <div class="col-lg-6">
        <div class="ylg-card p-4 h-100">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                <i class="bi bi-plus-circle text-primary me-1"></i> Thêm hoặc Cập nhật Node Hình học
            </h5>
            <form asp-action="SaveNode" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-2 mb-2">
                    <div class="col-sm-6">
                        <label class="form-label small fw-bold">Mã Node (ID duy nhất)</label>
                        <input name="Id" class="form-control form-control-sm" required placeholder="HinhVuong, HinhThoi..." />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small fw-bold">Tên hiển thị</label>
                        <input name="Label" class="form-control form-control-sm" required placeholder="Hình vuông..." />
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-sm-6">
                        <label class="form-label small fw-bold">Loại Node</label>
                        <select name="Type" class="form-select form-select-sm">
                            <option value="Shape">Shape (Hình học)</option>
                            <option value="Property">Property (Tính chất)</option>
                            <option value="Concept">Concept (Khái niệm)</option>
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small fw-bold">Cấp độ tối thiểu (Lớp)</label>
                        <select name="MinGrade" class="form-select form-select-sm">
                            <option value="6">Lớp 6</option>
                            <option value="8">Lớp 8</option>
                        </select>
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label small fw-bold">Định nghĩa</label>
                    <textarea name="Definition" class="form-control form-control-sm" rows="2"></textarea>
                </div>

                <div class="mb-2">
                    <label class="form-label small fw-bold">Dấu hiệu nhận biết</label>
                    <textarea name="IdentificationSign" class="form-control form-control-sm" rows="2"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">Mẹo học tính kế thừa</label>
                    <textarea name="LearningTip" class="form-control form-control-sm" rows="2" placeholder="Ví dụ: Kế thừa toàn bộ tính chất của Hình chữ nhật và Hình thoi..."></textarea>
                </div>

                <button type="submit" class="btn btn-ylg-primary btn-sm w-100">
                    <i class="bi bi-floppy me-1"></i> Lưu Node vào Neo4j
                </button>
            </form>
        </div>
    </div>

    <!-- Form Add Relationship -->
    <div class="col-lg-6">
        <div class="ylg-card p-4 h-100">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                <i class="bi bi-bezier2 text-success me-1"></i> Tạo mối liên hệ giữa các Node (Relationship)
            </h5>
            <form asp-action="SaveRelationship" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label small fw-bold">Node Nguồn (Source)</label>
                    <select name="SourceId" class="form-select form-select-sm" required>
                        <option value="">-- Chọn Node nguồn --</option>
                        @foreach (var n in Model)
                        {
                            <option value="@n.Id">@n.Label (@n.Id)</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">Loại quan hệ (Type)</label>
                    <select name="Type" class="form-select form-select-sm" required>
                        <option value="IS_SPECIAL_CASE_OF">IS_SPECIAL_CASE_OF (Trường hợp đặc biệt của)</option>
                        <option value="HAS_PROPERTY">HAS_PROPERTY (Có tính chất)</option>
                        <option value="RELATED_TO">RELATED_TO (Liên quan tới)</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">Node Đích (Target)</label>
                    <select name="TargetId" class="form-select form-select-sm" required>
                        <option value="">-- Chọn Node đích --</option>
                        @foreach (var n in Model)
                        {
                            <option value="@n.Id">@n.Label (@n.Id)</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">Nhãn hiển thị / Giải thích vì sao tồn tại</label>
                    <input name="Explanation" class="form-control form-control-sm" placeholder="Hình vuông có 4 góc vuông như hình chữ nhật..." />
                </div>

                <button type="submit" class="btn btn-ylg-success btn-sm w-100">
                    <i class="bi bi-link-45deg me-1"></i> Tạo mối liên hệ Neo4j
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Nodes Table -->
<div class="ylg-card p-4 mb-4">
    <h5 class="fw-bold text-dark mb-3">Danh sách Node trên Neo4j (@Model.Count Nodes)</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle small">
            <thead class="table-light">
                <tr>
                    <th>Mã Node</th>
                    <th>Tên hiển thị</th>
                    <th>Loại</th>
                    <th>Lớp</th>
                    <th>Định nghĩa</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var n in Model)
                {
                    <tr>
                        <td><code>@n.Id</code></td>
                        <td class="fw-bold text-dark">@n.Label</td>
                        <td><span class="badge bg-primary-subtle text-primary">@n.Type</span></td>
                        <td>Lớp @n.MinGrade</td>
                        <td class="text-truncate" style="max-width: 250px;">@n.Definition</td>
                        <td>
                            <form asp-action="DeleteNode" asp-route-id="@n.Id" method="post" onsubmit="return confirm('Bạn chắc chắn muốn xóa node này?');" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Relationships Table -->
<div class="ylg-card p-4">
    <h5 class="fw-bold text-dark mb-3">Danh sách Mối liên hệ quan hệ (@rels.Count Relationships)</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle small">
            <thead class="table-light">
                <tr>
                    <th>Nguồn (Source)</th>
                    <th>Loại quan hệ</th>
                    <th>Đích (Target)</th>
                    <th>Giải thích ý nghĩa kế thừa</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in rels)
                {
                    <tr>
                        <td class="fw-bold text-primary">@r.SourceId</td>
                        <td><span class="badge bg-secondary">@r.Type</span></td>
                        <td class="fw-bold text-success">@r.TargetId</td>
                        <td><small class="text-muted">@r.Explanation</small></td>
                        <td>
                            <form asp-action="DeleteRelationship" method="post" onsubmit="return confirm('Bạn chắc chắn muốn xóa quan hệ này?');" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="sourceId" value="@r.SourceId" />
                                <input type="hidden" name="targetId" value="@r.TargetId" />
                                <input type="hidden" name="type" value="@r.Type" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
