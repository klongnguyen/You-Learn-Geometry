@model List<YouLearnGeometry.Models.User>
@{
    ViewData["Title"] = "Quản lý Người dùng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark">
            <i class="bi bi-people-fill text-primary me-2"></i> Danh sách Người dùng
        </h3>
        <p class="text-muted mb-0">Quản lý trạng thái hoạt động và phân quyền tài khoản người dùng.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Quay lại Dashboard Admin
    </a>
</div>

<div class="ylg-card p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Họ và tên</th>
                    <th>Tên đăng nhập</th>
                    <th>Email</th>
                    <th>Lớp học</th>
                    <th>Vai trò</th>
                    <th>Streak</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="fw-bold">@user.FullName</td>
                        <td><code>@user.Username</code></td>
                        <td>@user.Email</td>
                        <td><span class="badge bg-light text-dark border">@user.GradeLevel</span></td>
                        <td>
                            <span class="badge @(user.Role == "Admin" ? "bg-danger" : "bg-primary")">
                                @user.Role
                            </span>
                        </td>
                        <td><span class="text-danger fw-bold"><i class="bi bi-fire"></i> @user.StreakCount</span></td>
                        <td>
                            <span class="badge @(user.IsActive ? "bg-success" : "bg-danger")">
                                @(user.IsActive ? "Hoạt động" : "Đã khóa")
                            </span>
                        </td>
                        <td>
                            @if (user.Username != "admin")
                            {
                                <form asp-action="ToggleUserStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        @(user.IsActive ? "Khóa TK" : "Mở khóa")
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Mặc định</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
