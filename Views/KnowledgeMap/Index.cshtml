@{
    ViewData["Title"] = "Bản đồ tri thức hình học";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark">
            Bản đồ tri thức hình học
        </h2>
        <p class="text-muted mb-0">Sơ đồ mối quan hệ kế thừa và chuyển hóa tính chất giữa các hình học phẳng.</p>
    </div>
    <div class="d-flex gap-2">
        <select id="gradeFilterSelect" class="form-select form-select-sm w-auto">
            <option value="">Tất cả cấp độ (Lớp 6 - 9)</option>
            <option value="6">Lớp 6 (Hình học trực quan)</option>
            <option value="7">Lớp 7 (Tam giác & Góc)</option>
            <option value="8">Lớp 8 (Tứ giác & Định lý)</option>
            <option value="9">Lớp 9 (Đường tròn & Lượng giác)</option>
        </select>
        <button id="btnFitGraph" class="btn btn-sm btn-outline-secondary">
            Căn giữa
        </button>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="ylg-card p-3 position-relative">
            <!-- Cytoscape Container -->
            <div id="cy-container" style="height: 620px; width: 100%;"></div>

            <!-- Legend Overlay -->
            <div class="position-absolute bottom-0 start-0 m-4 p-3 bg-white bg-opacity-95 rounded-3 border shadow-sm small" style="backdrop-filter: blur(4px);">
                <span class="d-block fw-bold text-dark mb-2">Phân loại hình học:</span>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span style="display:inline-block; width:12px; height:12px; background:#4338ca; border-radius:3px;"></span>
                    <span>Gốc Hình học phẳng</span>
                </div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span style="display:inline-block; width:12px; height:12px; background:#059669; border-radius:3px;"></span>
                    <span>Họ Tam giác</span>
                </div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span style="display:inline-block; width:12px; height:12px; background:#2563eb; border-radius:3px;"></span>
                    <span>Họ Tứ giác</span>
                </div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span style="display:inline-block; width:12px; height:12px; background:#e11d48; border-radius:3px;"></span>
                    <span>Họ Đường tròn</span>
                </div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span style="display:inline-block; width:12px; height:12px; background:#7c3aed; border-radius:3px;"></span>
                    <span>Đa giác đều</span>
                </div>
                <hr class="my-1 text-muted" />
                <div class="d-flex align-items-center gap-2">
                    <span style="display:inline-block; width:18px; height:2px; background:#4f46e5;"></span>
                    <span class="text-muted" style="font-size: 11px;">Mũi tên: Kế thừa / Chuyển hóa</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Node Inspector Drawer -->
    <div class="col-lg-4">
        <div class="ylg-card p-4 h-100" id="nodeDetailsCard">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                Thông tin hình học
            </h5>

            <div id="noSelectionMsg" class="text-center py-5 text-muted">
                <p class="mb-0">Chọn một hình bất kỳ trên bản đồ để xem định nghĩa, dấu hiệu nhận biết và liên hệ kế thừa.</p>
            </div>

            <div id="nodeContent" style="display:none;">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h3 class="fw-extrabold text-primary mb-0" id="nodeLabel">Hình vuông</h3>
                    <span class="badge bg-primary-subtle text-primary" id="nodeGrade">Lớp 6</span>
                </div>

                <div class="mb-3">
                    <strong class="d-block text-dark small fw-bold mb-1">Định nghĩa:</strong>
                    <div class="p-3 bg-light rounded-3 text-dark small" id="nodeDef"></div>
                </div>

                <div class="mb-3">
                    <strong class="d-block text-dark small fw-bold mb-1">Dấu hiệu nhận biết:</strong>
                    <div class="p-3 bg-light rounded-3 text-dark small" id="nodeSign"></div>
                </div>

                <div class="p-3 bg-warning bg-opacity-10 rounded-3 border border-warning-subtle mb-3">
                    <strong class="d-block text-warning-emphasis small fw-bold mb-1">
                        Mẹo ghi nhớ:
                    </strong>
                    <p class="mb-0 text-dark small" id="nodeTip"></p>
                </div>

                <div class="d-grid mt-4">
                    <a asp-controller="Curriculum" asp-action="Index" class="btn btn-outline-primary btn-sm">
                        Xem bài học liên quan
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Load Cytoscape.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cytoscape/3.28.1/cytoscape.min.js"></script>
    <script>
        let cy = null;

        function initCytoscape(elements) {
            cy = cytoscape({
                container: document.getElementById('cy-container'),
                elements: elements,
                style: [
                    {
                        selector: 'node',
                        style: {
                            'background-color': 'data(color)',
                            'label': 'data(label)',
                            'color': '#0f172a',
                            'font-family': 'Plus Jakarta Sans, sans-serif',
                            'font-weight': '600',
                            'font-size': '12px',
                            'text-valign': 'bottom',
                            'text-margin-y': '6px',
                            'width': '46px',
                            'height': '46px',
                            'border-width': '3px',
                            'border-color': '#ffffff',
                            'shadow-blur': '10px',
                            'shadow-color': 'rgba(0,0,0,0.12)',
                            'shadow-opacity': 0.8
                        }
                    },
                    {
                        selector: 'node:selected',
                        style: {
                            'border-color': '#f59e0b',
                            'border-width': '4px',
                            'width': '56px',
                            'height': '56px'
                        }
                    },
                    {
                        selector: 'edge',
                        style: {
                            'width': 2,
                            'line-color': '#6366f1',
                            'target-arrow-color': '#6366f1',
                            'target-arrow-shape': 'triangle',
                            'curve-style': 'bezier',
                            'arrow-scale': 1.1,
                            'opacity': 0.85,
                            'label': 'data(label)',
                            'font-size': '10px',
                            'text-rotation': 'autorotate',
                            'text-background-opacity': 0.85,
                            'text-background-color': '#ffffff',
                            'text-background-padding': '2px',
                            'color': '#475569'
                        }
                    }
                ],
                layout: {
                    name: 'breadthfirst',
                    directed: true,
                    roots: '#HinhHocPhang, #HinhTuGiac, #HinhTamGiac, #HinhTron',
                    padding: 30,
                    spacingFactor: 1.25
                }
            });

            cy.on('tap', 'node', function(evt) {
                const node = evt.target;
                const d = node.data();
                showNodeDetails(d);
            });

            document.getElementById('btnFitGraph').addEventListener('click', () => {
                cy.fit(null, 30);
            });
        }

        function showNodeDetails(d) {
            document.getElementById('noSelectionMsg').style.display = 'none';
            document.getElementById('nodeContent').style.display = 'block';

            document.getElementById('nodeLabel').innerText = d.label;
            document.getElementById('nodeGrade').innerText = 'Lớp ' + (d.minGrade || '6');
            document.getElementById('nodeDef').innerText = d.definition || 'Đang cập nhật định nghĩa.';
            document.getElementById('nodeSign').innerText = d.identificationSign || 'Đang cập nhật dấu hiệu.';
            document.getElementById('nodeTip').innerText = d.learningTip || 'Quan sát sơ đồ để thấy tính kế thừa tính chất từ các hình cha.';
        }

        function loadGraphData(minGrade) {
            let url = '/KnowledgeMap/GetGraphData';
            if (minGrade) url += `?minGrade=${minGrade}`;

            fetch(url)
            .then(res => res.json())
            .then(data => {
                const elements = [];
                (data.nodes || []).forEach(n => {
                    elements.push({ group: 'nodes', data: n.data });
                });
                (data.edges || []).forEach(e => {
                    elements.push({ group: 'edges', data: e.data });
                });

                if (cy) cy.destroy();
                initCytoscape(elements);
            })
            .catch(err => console.error(err));
        }

        document.getElementById('gradeFilterSelect').addEventListener('change', function() {
            loadGraphData(this.value);
        });

        loadGraphData('');
    </script>
}
