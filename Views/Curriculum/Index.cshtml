@model YouLearnGeometry.ViewModels.CurriculumViewModel
@{
    ViewData["Title"] = "Chương trình & Bài học - YLG";
    ViewData["FluidLayout"] = true;
}

<style>
    .topic-nav-btn {
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
    }
    .topic-nav-btn:hover {
        background-color: #f1f5f9 !important;
    }
    .lesson-row-card {
        transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
    }
    .lesson-row-card:hover {
        border-color: #93c5fd !important;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.08) !important;
        transform: translateY(-1px);
    }
</style>

<div class="d-flex w-100 position-relative" style="min-height: calc(100vh - 65px);">
    <!-- LEFT SIDEBAR: Coursera-style flush, borderless navigation rail -->
    <aside id="curriculumSidebar" class="bg-white border-end flex-shrink-0" style="width: 320px; min-width: 320px; max-width: 340px;">
        <div class="sticky-top d-flex flex-column" style="top: 65px; height: calc(100vh - 65px);">
            <!-- Sidebar Header: Course Brand & Grade Switcher -->
            <div class="p-3 border-bottom flex-shrink-0 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-uppercase text-muted fw-bold" style="font-size: 0.72rem; letter-spacing: 0.08em;">Khóa học</span>
                    <!-- Grade Switcher Pills -->
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle py-0 px-2 fw-semibold" style="font-size: 0.78rem;" type="button" data-bs-toggle="dropdown">
                            @(Model.GradeLevel switch {
                                "Lop6" => "Lớp 6",
                                "Lop7" => "Lớp 7",
                                "Lop8" => "Lớp 8",
                                "Lop9" => "Lớp 9",
                                _ => "Chọn lớp"
                            })
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm small">
                            <li><a class="dropdown-item @(Model.GradeLevel == "Lop6" ? "active" : "")" asp-controller="Curriculum" asp-action="Index" asp-route-grade="Lop6">Lớp 6 (Hình học trực quan)</a></li>
                            <li><a class="dropdown-item @(Model.GradeLevel == "Lop7" ? "active" : "")" asp-controller="Curriculum" asp-action="Index" asp-route-grade="Lop7">Lớp 7 (Tam giác & Góc)</a></li>
                            <li><a class="dropdown-item @(Model.GradeLevel == "Lop8" ? "active" : "")" asp-controller="Curriculum" asp-action="Index" asp-route-grade="Lop8">Lớp 8 (Tứ giác & Định lý)</a></li>
                            <li><a class="dropdown-item @(Model.GradeLevel == "Lop9" ? "active" : "")" asp-controller="Curriculum" asp-action="Index" asp-route-grade="Lop9">Lớp 9 (Đường tròn & Lượng giác)</a></li>
                        </ul>
                    </div>
                </div>
                <h5 class="fw-extrabold text-dark mb-0 fs-6">@Model.GradeTitle</h5>
            </div>

            <!-- Course Material / Danh mục chủ đề (Coursera modules list) -->
            <div class="p-3 flex-grow-1 overflow-y-auto">
                <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                    <span class="text-uppercase text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Chủ đề học tập</span>
                    <span class="small text-muted">@Model.Topics.Count chủ đề</span>
                </div>

                <div class="d-flex flex-column gap-1" id="topicListNav">
                    @for (int i = 0; i < Model.Topics.Count; i++)
                    {
                        var tItem = Model.Topics[i];
                        bool isActive = (tItem.Topic.TopicCode == Model.ActiveTopicCode);

                        <button type="button"
                                class="topic-nav-btn w-100 text-start border-0 py-2 px-3 rounded-3 d-flex align-items-center gap-2 mb-1 @(isActive ? "bg-primary-subtle text-primary fw-semibold" : "bg-transparent text-dark")"
                                data-topic-code="@tItem.Topic.TopicCode"
                                onclick="switchTopic('@tItem.Topic.TopicCode')">
                            <!-- Status icon: Coursera Checkmark ✓ or Circle ○ -->
                            <div class="flex-shrink-0">
                                @if (tItem.IsCompleted)
                                {
                                    <span class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center" style="width: 20px; height: 20px; font-size: 11px;">✓</span>
                                }
                                else if (tItem.CompletedLessonsCount > 0)
                                {
                                    <span class="rounded-circle border border-primary text-primary d-inline-flex align-items-center justify-content-center" style="width: 20px; height: 20px; font-size: 9px;">●</span>
                                }
                                else
                                {
                                    <span class="rounded-circle border border-secondary d-inline-block" style="width: 20px; height: 20px;"></span>
                                }
                            </div>
                            <div class="flex-grow-1 text-truncate small">
                                @tItem.Topic.Title
                            </div>
                        </button>
                    }
                </div>
            </div>

            <!-- Sidebar Footer Quick Links -->
            <div class="p-3 border-top flex-shrink-0 bg-white small">
                <div class="d-flex flex-column gap-2">
                    <a asp-controller="KnowledgeMap" asp-action="Index" class="text-decoration-none text-muted fw-medium py-1">
                        Bản đồ tri thức hình học
                    </a>
                    <a asp-controller="GeometryLab" asp-action="Index" class="text-decoration-none text-muted fw-medium py-1">
                        Geometry Lab
                    </a>
                    <a asp-controller="PropertyBuilder" asp-action="Index" class="text-decoration-none text-muted fw-medium py-1">
                        Property Builder
                    </a>
                </div>
            </div>
        </div>
    </aside>

    <!-- RIGHT MAIN CONTENT: Selected Module & Vertical List of Lessons -->
    <main id="curriculumMainContent" class="flex-grow-1 min-vw-0 px-3 px-md-4 px-xl-5 py-4 overflow-y-auto">
        <div style="max-width: 1050px; margin: 0 auto;">
            @foreach (var tItem in Model.Topics)
            {
                bool isActive = (tItem.Topic.TopicCode == Model.ActiveTopicCode);
                double percent = tItem.TotalLessonsCount > 0 ? Math.Round((double)tItem.CompletedLessonsCount / tItem.TotalLessonsCount * 100) : 0;

                <div class="topic-content-pane @(isActive ? "" : "d-none")" id="topic_pane_@tItem.Topic.TopicCode">
                    <!-- Module Header (Coursera Module Style) -->
                    <div class="mb-4 pb-3 border-bottom">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <h2 class="fw-extrabold text-dark mb-1">@tItem.Topic.Title</h2>
                                <p class="text-muted fs-6 mb-2">@tItem.Topic.Description</p>
                            </div>
                            @if (tItem.IsCompleted)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-semibold">
                                    ✓ Đã hoàn thành chủ đề
                                </span>
                            }
                        </div>

                        <!-- Progress Bar & Summary Stats -->
                        <div class="d-flex align-items-center gap-2 small text-muted">
                            <span>@tItem.TotalLessonsCount bài học</span>
                            <span>•</span>
                            <span>1 bài kiểm tra chủ đề</span>
                            <span>•</span>
                            <span>Tiến độ: <strong>@tItem.CompletedLessonsCount/@tItem.TotalLessonsCount bài (@percent%)</strong></span>
                        </div>
                        <div class="progress mt-2" style="height: 6px;">
                            <div class="progress-bar bg-primary" role="progressbar" style="width: @percent%;" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>

                    <!-- Vertical List of Lessons (Sắp xếp các bài theo chiều dọc) -->
                    <div class="d-flex flex-column gap-3 mb-4">
                        @foreach (var item in tItem.Lessons)
                        {
                            bool isDone = (item.Progress?.Status == "Completed");
                            bool isLearning = (item.Progress?.Status == "Learning" || item.Progress?.Status == "AwaitingTest");

                            <div class="p-3 bg-white border rounded-3 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 lesson-row-card shadow-xs">
                                <div class="d-flex align-items-start gap-3">
                                    <!-- Status Icon -->
                                    <div class="mt-1 flex-shrink-0">
                                        @if (isDone)
                                        {
                                            <span class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center" style="width: 24px; height: 24px; font-size: 13px;" title="Đã hoàn thành">✓</span>
                                        }
                                        else if (isLearning)
                                        {
                                            <span class="rounded-circle border border-primary text-primary d-inline-flex align-items-center justify-content-center" style="width: 24px; height: 24px; font-size: 10px;" title="Đang học">●</span>
                                        }
                                        else
                                        {
                                            <span class="rounded-circle border border-secondary d-inline-block" style="width: 24px; height: 24px;" title="Chưa học"></span>
                                        }
                                    </div>

                                    <!-- Content Info -->
                                    <div>
                                        <h6 class="fw-bold text-dark mb-1 fs-6">@item.Lesson.Title</h6>
                                        <p class="text-muted small mb-2" style="max-width: 680px; line-height: 1.5;">@item.Lesson.Summary</p>
                                        <div class="d-flex align-items-center gap-2 text-muted small" style="font-size: 0.8rem;">
                                            <span>@(item.Lesson.HasGeometryLab ? "Lab tương tác" : "Lý thuyết")</span>
                                            @if (item.Lesson.HasMiniTest)
                                            {
                                                <span>•</span>
                                                <span>Mini Test (4 câu)</span>
                                            }
                                            @if (item.Progress?.BestMiniTestScore > 0)
                                            {
                                                <span>•</span>
                                                <span class="text-success fw-semibold">Điểm: @item.Progress.BestMiniTestScore%</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- Action Button -->
                                <div class="flex-shrink-0 text-md-end">
                                    <a asp-controller="Lesson" asp-action="Detail" asp-route-id="@item.Lesson.Id"
                                       class="btn btn-sm @(isDone ? "btn-outline-secondary" : (isLearning ? "btn-ylg-primary" : "btn-outline-primary")) px-3 py-2 fw-semibold">
                                        @(isDone ? "Ôn tập" : (isLearning ? "Tiếp tục học →" : "Học ngay →"))
                                    </a>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Topic Challenge Card (Coursera Module Challenge Style) -->
                    <div class="p-4 rounded-3 border @(tItem.IsTopicTestUnlocked ? "bg-primary-subtle border-primary-subtle" : "bg-light")">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge @(tItem.IsTopicTestUnlocked ? "bg-primary" : "bg-secondary") rounded-pill">
                                        Bài kiểm tra chủ đề (10 câu)
                                    </span>
                                    @if (tItem.LatestTopicTestAttempt?.IsPassed == true)
                                    {
                                        <span class="badge bg-success rounded-pill">✓ Đã đạt</span>
                                    }
                                </div>
                                <h5 class="fw-bold text-dark mb-1">Bài kiểm tra tổng hợp: @tItem.Topic.Title</h5>
                                <p class="text-muted small mb-0">
                                    @if (tItem.IsTopicTestUnlocked)
                                    {
                                        <span>Đã mở khóa. Đạt từ 70% trở lên để hoàn thành chủ đề.</span>
                                    }
                                    else
                                    {
                                        <span>Hoàn thành tất cả các bài học trong chủ đề để mở khóa bài kiểm tra này.</span>
                                    }
                                </p>
                                @if (tItem.LatestTopicTestAttempt != null)
                                {
                                    <div class="mt-2 small text-muted">
                                        Lần làm gần nhất: <strong class="@(tItem.LatestTopicTestAttempt.IsPassed ? "text-success" : "text-danger")">@tItem.LatestTopicTestAttempt.Score% (@tItem.LatestTopicTestAttempt.CorrectCount/@tItem.LatestTopicTestAttempt.TotalQuestions câu)</strong> - @(tItem.LatestTopicTestAttempt.IsPassed ? "Đạt" : "Chưa đạt")
                                    </div>
                                }
                            </div>
                            <div class="flex-shrink-0">
                                @if (tItem.IsTopicTestUnlocked)
                                {
                                    <a asp-controller="Assessment" asp-action="TopicTest" asp-route-topicCode="@tItem.Topic.TopicCode" class="btn btn-ylg-primary px-4 py-2 fw-semibold">
                                        @(tItem.LatestTopicTestAttempt != null ? "Làm lại kiểm tra" : "Làm bài kiểm tra")
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-secondary px-4 py-2" disabled>
                                        Chưa mở khóa
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </main>
</div>

@section Scripts {
    <script>
        function switchTopic(code) {
            // Hide all panes
            document.querySelectorAll('.topic-content-pane').forEach(el => el.classList.add('d-none'));

            // Show active pane
            const targetPane = document.getElementById('topic_pane_' + code);
            if (targetPane) targetPane.classList.remove('d-none');

            // Update button styles in left sidebar
            document.querySelectorAll('.topic-nav-btn').forEach(btn => {
                if (btn.getAttribute('data-topic-code') === code) {
                    btn.classList.add('bg-primary-subtle', 'text-primary', 'fw-semibold');
                    btn.classList.remove('bg-transparent', 'text-dark');
                } else {
                    btn.classList.remove('bg-primary-subtle', 'text-primary', 'fw-semibold');
                    btn.classList.add('bg-transparent', 'text-dark');
                }
            });

            // Update URL query parameter
            const url = new URL(window.location);
            url.searchParams.set('topic', code);
            window.history.replaceState({}, '', url);
        }
    </script>
}
