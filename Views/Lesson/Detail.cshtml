@model YouLearnGeometry.ViewModels.LessonDetailViewModel
@{
    ViewData["Title"] = Model.Lesson.Title;
    var statusClass = Model.CurrentStatus switch
    {
        "Completed" => "bg-success text-white",
        "AwaitingTest" => "bg-warning text-dark",
        "Learning" => "bg-info text-white",
        _ => "bg-secondary text-white"
    };
    var statusText = Model.CurrentStatus switch
    {
        "Completed" => "Đã hoàn thành",
        "AwaitingTest" => "Chờ kiểm tra Mini Test",
        "Learning" => "Đang học",
        _ => "Chưa học"
    };
}

<div class="row g-4">
    <div class="col-lg-9">
        <!-- Lesson Header -->
        <div class="ylg-card p-4 mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <a asp-controller="Curriculum" asp-action="Index" class="text-decoration-none small text-muted">
                    Quay lại danh sách bài học
                </a>
                <span class="badge @statusClass badge-status">
                    @statusText
                </span>
            </div>
            <h2 class="fw-extrabold text-dark mb-2">@Model.Lesson.Title</h2>
            <p class="text-muted lead fs-6 mb-0">@Model.Lesson.Summary</p>
        </div>

        <!-- Section 1: Khái niệm & Định nghĩa -->
        <div class="ylg-card p-4 mb-4">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                Khái niệm & Định nghĩa
            </h5>
            <div class="p-3 bg-light rounded-3 border-start border-4 border-primary fs-6 text-dark lh-base">
                @Model.Lesson.Definition
            </div>
        </div>

        <!-- Section 2: Tính chất & Công thức -->
        <div class="ylg-card p-4 mb-4">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                Tính chất & Công thức
            </h5>
            <div class="row g-3">
                <div class="col-md-7">
                    <h6 class="fw-bold text-dark mb-2">Các tính chất quan trọng:</h6>
                    <ul class="list-group list-group-flush">
                        @foreach (var prop in Model.Lesson.Properties)
                        {
                            <li class="list-group-item px-0 py-2 text-dark bg-transparent">
                                • @prop
                            </li>
                        }
                    </ul>
                </div>
                <div class="col-md-5">
                    @if (Model.Lesson.Formulas.Any())
                    {
                        <div class="p-3 bg-primary bg-opacity-10 rounded-3 border border-primary-subtle h-100">
                            <h6 class="fw-bold text-primary mb-2">Công thức cần nhớ:</h6>
                            @foreach (var f in Model.Lesson.Formulas)
                            {
                                <div class="p-2 mb-2 bg-white rounded border fw-semibold text-dark small">
                                    @f
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Section 3: Ví dụ minh họa & Thực tiễn -->
        <div class="ylg-card p-4 mb-4">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                Ví dụ minh họa & Liên hệ thực tiễn
            </h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 h-100 border">
                        <strong class="d-block text-dark mb-1">Ví dụ toán học:</strong>
                        <p class="text-muted small mb-0">@Model.Lesson.VisualExample</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 h-100 border">
                        <strong class="d-block text-dark mb-1">Ứng dụng thực tiễn:</strong>
                        <p class="text-muted small mb-0">@Model.Lesson.RealWorldExample</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 4: Geometry Lab (Nếu có) -->
        @if (Model.Lesson.HasGeometryLab)
        {
            <div class="ylg-card p-4 mb-4" id="labSection">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                    <h5 class="fw-bold text-dark mb-0">
                        Geometry Lab
                    </h5>
                    <span class="badge bg-primary-subtle text-primary">Kéo 4 đỉnh A, B, C, D</span>
                </div>
                <p class="text-muted small mb-3">
                    Kéo các đỉnh để quan sát sự thay đổi góc và cạnh theo thời gian thực.
                </p>

                <div class="row g-3 align-items-center">
                    <div class="col-md-8">
                        <div class="lab-canvas-container" style="height: 340px;">
                            <svg id="lessonLabSvg" width="100%" height="340" viewBox="0 0 500 340" data-default-shape="@Model.Lesson.DefaultLabShape">
                                <defs>
                                    <pattern id="lessonGrid" width="20" height="20" patternUnits="userSpaceOnUse">
                                        <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#f1f5f9" stroke-width="1"/>
                                    </pattern>
                                </defs>
                                <rect width="500" height="340" fill="url(#lessonGrid)" />

                                <!-- Polygon -->
                                <polygon id="labPoly" class="lab-polygon" points="120,60 380,60 380,260 120,260" />
                                
                                <!-- Diagonals -->
                                <line id="labDiag1" class="lab-diagonal" x1="120" y1="60" x2="380" y2="260" />
                                <line id="labDiag2" class="lab-diagonal" x1="380" y1="60" x2="120" y2="260" />

                                <!-- Vertices -->
                                <circle id="ptA" class="lab-vertex" cx="120" cy="60" r="8" />
                                <text id="lblA" x="100" y="55" font-weight="bold" fill="#1e1b4b">A</text>

                                <circle id="ptB" class="lab-vertex" cx="380" cy="60" r="8" />
                                <text id="lblB" x="390" y="55" font-weight="bold" fill="#1e1b4b">B</text>

                                <circle id="ptC" class="lab-vertex" cx="380" cy="260" r="8" />
                                <text id="lblC" x="390" y="275" font-weight="bold" fill="#1e1b4b">C</text>

                                <circle id="ptD" class="lab-vertex" cx="120" cy="260" r="8" />
                                <text id="lblD" x="100" y="275" font-weight="bold" fill="#1e1b4b">D</text>
                            </svg>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="text-muted small d-block mb-1">Loại hình nhận diện:</span>
                            <h5 id="labDetectedShape" class="fw-bold text-primary mb-3">Hình chữ nhật</h5>

                            <div class="small text-muted mb-2">Độ dài cạnh:</div>
                            <div class="d-flex justify-content-between small mb-1">
                                <span>AB: <strong id="lenAB">260</strong></span>
                                <span>BC: <strong id="lenBC">200</strong></span>
                            </div>
                            <div class="d-flex justify-content-between small mb-3">
                                <span>CD: <strong id="lenCD">260</strong></span>
                                <span>DA: <strong id="lenDA">200</strong></span>
                            </div>

                            <div class="small text-muted mb-2">Góc tại đỉnh:</div>
                            <div class="d-flex justify-content-between small mb-1">
                                <span>Â: <strong id="angA">90°</strong></span>
                                <span>B̂: <strong id="angB">90°</strong></span>
                            </div>
                            <div class="d-flex justify-content-between small mb-3">
                                <span>Ĉ: <strong id="angC">90°</strong></span>
                                <span>D̂: <strong id="angD">90°</strong></span>
                            </div>

                            <button id="btnResetLab" class="btn btn-sm btn-outline-secondary w-100">
                                Khôi phục hình gốc
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Section 5: Bài tập thực hành -->
        @if (Model.Lesson.PracticeExercises.Any())
        {
            <div class="ylg-card p-4 mb-4">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                    Bài tập thực hành
                </h5>
                <p class="text-muted small mb-3">
                    Trả lời các câu hỏi bên dưới để củng cố kiến thức bài học.
                </p>

                @for (int i = 0; i < Model.Lesson.PracticeExercises.Count; i++)
                {
                    var ex = Model.Lesson.PracticeExercises[i];
                    <div class="practice-box" id="practiceBox_@ex.Id" data-attempt="0">
                        <h6 class="fw-bold text-dark mb-2">Câu @(i + 1): @ex.QuestionText</h6>

                        @if (ex.Type == "single_choice" && ex.Options.Any())
                        {
                            <div class="mb-3">
                                @foreach (var opt in ex.Options)
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="radio" name="opt_@ex.Id" id="opt_@(ex.Id)_@(opt.GetHashCode())" value="@opt">
                                        <label class="form-check-label text-dark" for="opt_@(ex.Id)_@(opt.GetHashCode())">
                                            @opt
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="mb-3" style="max-width: 260px;">
                                <input type="text" class="form-control" id="input_@ex.Id" placeholder="Nhập câu trả lời số...">
                            </div>
                        }

                        <button type="button" class="btn btn-sm btn-outline-primary px-3" onclick="submitPractice('@Model.Lesson.Id', '@ex.Id', '@ex.Type')">
                            Kiểm tra kết quả
                        </button>

                        <!-- Feedback Message -->
                        <div id="feedback_@ex.Id" class="mt-2 small fw-semibold" style="display:none;"></div>
                        <!-- Hint Banner -->
                        <div id="hint_@ex.Id" class="hint-banner" style="display:none;"></div>
                        <!-- Answer Explanation -->
                        <div id="expl_@ex.Id" class="p-2 bg-light rounded mt-2 small text-dark border" style="display:none;"></div>
                    </div>
                }
            </div>
        }

        <!-- Section 6: Xác nhận hoàn thành bài học -->
        <div class="ylg-card p-4 p-md-5 mb-4 text-center bg-light border-2 border-primary border-dashed">
            <h4 class="fw-bold text-dark mb-2">
                Xác nhận hoàn thành bài học
            </h4>
            <p class="text-muted small mb-4" style="max-width: 580px; margin: 0 auto;">
                Nhấn nút bên dưới sau khi bạn đã đọc và hiểu các nội dung trong bài học.
            </p>

            <form asp-action="MarkCompleted" asp-route-id="@Model.Lesson.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-ylg-success btn-lg px-5 py-3 fs-5 shadow">
                    Đánh dấu hoàn thành bài học
                </button>
            </form>

            @if (Model.CurrentStatus == "Completed")
            {
                <div class="text-success fw-bold mt-3">
                    Bạn đã hoàn thành bài học này.
                </div>
            }
        </div>

        <!-- Section 7: Mini Test (Nếu có) -->
        @if (Model.Lesson.HasMiniTest && Model.Lesson.MiniTest.Any())
        {
            <div class="ylg-card p-4 mb-4" id="miniTestSection">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                    <h5 class="fw-bold text-dark mb-0">
                        Mini Test (@Model.Lesson.MiniTest.Count câu)
                    </h5>
                    <div>
                        <span class="badge bg-warning text-dark">Ngưỡng đạt: 75%</span>
                        @if (Model.Progress?.BestMiniTestScore > 0)
                        {
                            <span class="badge bg-light text-dark border ms-1">
                                Điểm cao nhất: <strong>@Model.Progress.BestMiniTestScore%</strong>
                            </span>
                        }
                    </div>
                </div>
                <p class="text-muted small mb-4">
                    Làm bài kiểm tra ngắn để tự đánh giá mức độ tiếp thu bài học. Ngưỡng đạt từ 75% trở lên.
                </p>

                <form asp-action="SubmitMiniTest" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="LessonId" value="@Model.Lesson.Id" />

                    @for (int i = 0; i < Model.Lesson.MiniTest.Count; i++)
                    {
                        var q = Model.Lesson.MiniTest[i];
                        <div class="p-3 mb-3 border rounded-3 bg-white">
                            <h6 class="fw-bold text-dark mb-3">@q.QuestionText</h6>
                            <input type="hidden" name="Answers[@i].QuestionId" value="@q.Id" />
                            @foreach (var opt in q.Options)
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="Answers[@i].SelectedOption" id="test_@(q.Id)_@(opt.GetHashCode())" value="@opt" required>
                                    <label class="form-check-label text-dark" for="test_@(q.Id)_@(opt.GetHashCode())">
                                        @opt
                                    </label>
                                </div>
                            }
                        </div>
                    }

                    <div class="text-end mt-4">
                        <button type="submit" class="btn btn-ylg-primary px-4 py-2">
                            Nộp bài Mini Test
                        </button>
                    </div>
                </form>
            </div>
        }

        <!-- Bottom Navigation -->
        <div class="d-flex justify-content-between align-items-center pt-3">
            @if (Model.PreviousLesson != null)
            {
                <a asp-action="Detail" asp-route-id="@Model.PreviousLesson.Id" class="btn btn-outline-secondary">
                    Bài trước: @Model.PreviousLesson.Title
                </a>
            }
            else
            {
                <div></div>
            }

            @if (Model.NextLesson != null)
            {
                <a asp-action="Detail" asp-route-id="@Model.NextLesson.Id" class="btn btn-ylg-primary">
                    Bài tiếp: @Model.NextLesson.Title
                </a>
            }
        </div>
    </div>

    <!-- Right Sidebar Navigation -->
    <div class="col-lg-3">
        <div class="ylg-card p-3 sticky-top" style="top: 85px;">
            <h6 class="fw-bold text-dark mb-3">Mục lục bài học</h6>
            <div class="nav flex-column gap-2 small">
                <a href="#" class="nav-link text-muted px-2 py-1">1. Khái niệm</a>
                <a href="#" class="nav-link text-muted px-2 py-1">2. Tính chất & Công thức</a>
                <a href="#" class="nav-link text-muted px-2 py-1">3. Ví dụ minh họa</a>
                @if (Model.Lesson.HasGeometryLab)
                {
                    <a href="#labSection" class="nav-link text-muted px-2 py-1">4. Geometry Lab</a>
                }
                @if (Model.Lesson.PracticeExercises.Any())
                {
                    <a href="#" class="nav-link text-muted px-2 py-1">5. Bài tập thực hành</a>
                }
                @if (Model.Lesson.HasMiniTest)
                {
                    <a href="#miniTestSection" class="nav-link text-muted px-2 py-1">6. Mini Test</a>
                }
            </div>

            <hr class="my-3">
            <div class="p-2 bg-light rounded text-center small text-muted">
                Liên hệ tri thức: <br />
                <a asp-controller="KnowledgeMap" asp-action="Index" class="fw-bold text-primary">
                    Xem Bản đồ tri thức
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/lesson-practice.js" asp-append-version="true"></script>
    @if (Model.Lesson.HasGeometryLab)
    {
        <script src="~/js/geometry-lab.js" asp-append-version="true"></script>
    }
}
