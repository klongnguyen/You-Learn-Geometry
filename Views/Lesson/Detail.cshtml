@model YouLearnGeometry.ViewModels.LessonDetailViewModel
@{
    ViewData["Title"] = Model.Lesson.Title;
    ViewData["FluidLayout"] = true;
    var statusClass = Model.CurrentStatus switch
    {
        "Completed" => "bg-success text-white",
        "AwaitingTest" => "bg-warning text-dark",
        "Learning" => "bg-info text-white",
        _ => "bg-secondary text-white"
    };
    var statusText = Model.CurrentStatus switch
    {
        "Completed" => "Đã hoàn thành",
        "AwaitingTest" => "Chờ kiểm tra Mini Test",
        "Learning" => "Đang học",
        _ => "Chưa học"
    };
}

<style>
    #btnExpandSidebar {
        transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.2s ease, background-color 0.2s ease;
    }
    #btnExpandSidebar:hover {
        transform: translateX(4px);
        background-color: #eff6ff !important;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.25) !important;
        color: #1d4ed8 !important;
    }
    #btnCollapseSidebar {
        transition: background-color 0.15s ease, color 0.15s ease;
    }
    #btnCollapseSidebar:hover {
        background-color: #e2e8f0 !important;
        color: #0f172a !important;
    }
    .module-header:hover {
        background-color: #e2e8f0 !important;
    }
</style>

<!-- Floating dock tab to reopen sidebar when collapsed (stays fixed on left edge) -->
<button id="btnExpandSidebar" type="button"
        class="btn bg-white text-primary border shadow-sm p-0 d-none align-items-center justify-content-center"
        title="Hiện danh sách bài học"
        aria-label="Hiện danh sách bài học"
        style="position: fixed; left: 0; top: 120px; width: 36px; height: 48px; border-top-left-radius: 0; border-bottom-left-radius: 0; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-left: none; z-index: 1045; cursor: pointer;">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
</button>

<div class="d-flex w-100 position-relative" id="lessonContainerWrapper" style="min-height: calc(100vh - 120px);">
    <!-- LEFT SIDEBAR: Sát lề bên trái, không kẻ khung, chuẩn Coursera -->
    <aside id="courseSidebarCol" class="bg-white border-end flex-shrink-0" style="width: 320px; min-width: 320px; max-width: 340px;">
        <div class="sticky-top d-flex flex-column" style="top: 65px; height: calc(100vh - 65px);">
            <!-- Sidebar Header with close icon button -->
            <div class="px-3 py-3 border-bottom d-flex justify-content-between align-items-center flex-shrink-0 bg-white">
                <span class="fw-bold text-dark text-truncate me-2 fs-6" title="@Model.GradeTitle">@Model.GradeTitle</span>
                <button id="btnCollapseSidebar" type="button"
                        class="btn btn-sm btn-light border-0 text-muted rounded-circle p-1 d-flex align-items-center justify-content-center flex-shrink-0"
                        title="Thu gọn danh sách bài học"
                        aria-label="Thu gọn danh sách bài học"
                        style="width: 32px; height: 32px;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                </button>
            </div>

            <!-- Module Accordion: Flat, No Card Frame -->
            <div class="flex-grow-1 overflow-y-auto" id="moduleAccordion">
                @for (int tIdx = 0; tIdx < Model.CourseTopics.Count; tIdx++)
                {
                    var tItem = Model.CourseTopics[tIdx];
                    bool isCurrentTopic = tItem.Lessons.Any(l => l.Lesson.Id == Model.Lesson.Id) || (tItem.Topic.TopicCode == Model.CurrentTopicCode);
                    string collapseId = $"collapse_topic_{tIdx}";

                    <div class="border-bottom">
                        <!-- Module Header with arrow toggle -->
                        <div class="p-3 bg-light-subtle d-flex justify-content-between align-items-center module-header"
                             data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(isCurrentTopic ? "true" : "false")"
                             style="cursor: pointer; user-select: none;">
                            <div class="small fw-bold text-dark text-truncate pe-2">
                                @tItem.Topic.Title
                            </div>
                            <span class="chevron-icon small text-muted">@(isCurrentTopic ? "▲" : "▼")</span>
                        </div>

                        <!-- Module Lessons List -->
                        <div id="@collapseId" class="collapse @(isCurrentTopic ? "show" : "")">
                            <div class="list-group list-group-flush small">
                                @foreach (var lItem in tItem.Lessons)
                                {
                                    bool isCurrentLesson = (lItem.Lesson.Id == Model.Lesson.Id);
                                    bool isDone = (lItem.Progress?.Status == "Completed");

                                    <a asp-action="Detail" asp-route-id="@lItem.Lesson.Id"
                                       class="list-group-item list-group-item-action d-flex align-items-start gap-2 py-2 px-3 border-0 @(isCurrentLesson ? "bg-primary-subtle text-primary fw-semibold border-start border-4 border-primary" : "text-dark")">
                                        <div class="mt-1 flex-shrink-0">
                                            @if (isDone)
                                            {
                                                <span class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center" style="width: 18px; height: 18px; font-size: 11px;">✓</span>
                                            }
                                            else if (lItem.Progress?.Status == "AwaitingTest" || lItem.Progress?.Status == "Learning")
                                            {
                                                <span class="rounded-circle border border-primary text-primary d-inline-flex align-items-center justify-content-center" style="width: 18px; height: 18px; font-size: 9px;">●</span>
                                            }
                                            else
                                            {
                                                <span class="rounded-circle border border-secondary d-inline-block" style="width: 18px; height: 18px;"></span>
                                            }
                                        </div>
                                        <div class="flex-grow-1 text-truncate">
                                            <div class="text-truncate">@lItem.Lesson.Title</div>
                                            <div class="text-muted" style="font-size: 0.72rem;">
                                                @(lItem.Lesson.HasGeometryLab ? "Lab tương tác" : "Lý thuyết")
                                                @(lItem.Lesson.HasMiniTest ? " • Mini Test" : "")
                                            </div>
                                        </div>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Knowledge Map Shortcut -->
            <div class="p-3 border-top text-center small flex-shrink-0 bg-white">
                <a asp-controller="KnowledgeMap" asp-action="Index" class="text-decoration-none fw-semibold text-primary d-inline-flex align-items-center gap-1">
                    <span>Bản đồ tri thức hình học</span>
                    <span>&rarr;</span>
                </a>
            </div>
        </div>
    </aside>

    <!-- RIGHT MAIN CONTENT: Padded & Centered reading flow -->
    <main id="mainContentCol" class="flex-grow-1 min-vw-0 px-3 px-md-4 px-xl-5 py-4 overflow-x-hidden">
        <div style="max-width: 1100px; margin: 0 auto;">
            <!-- Top Header / Breadcrumb -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="Curriculum" asp-action="Index" class="btn btn-sm btn-light border text-muted">
                        Lộ trình học tập
                    </a>
                    <span class="text-muted small">&rsaquo;</span>
                    <span class="text-dark small fw-semibold">@Model.GradeTitle</span>
                </div>

                <div>
                    <span class="badge @statusClass badge-status">
                        @statusText
                    </span>
                </div>
            </div>
        <!-- Lesson Header -->
        <div class="ylg-card p-4 mb-4">
            <h2 class="fw-extrabold text-dark mb-2">@Model.Lesson.Title</h2>
            <p class="text-muted lead fs-6 mb-0">@Model.Lesson.Summary</p>
        </div>

        <!-- Section 1: Khái niệm & Định nghĩa -->
        <div class="ylg-card p-4 mb-4">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                Khái niệm & Định nghĩa
            </h5>
            <div class="p-3 bg-light rounded-3 border-start border-4 border-primary fs-6 text-dark lh-base">
                @Model.Lesson.Definition
            </div>
        </div>

        <!-- Section 2: Tính chất & Công thức -->
        <div class="ylg-card p-4 mb-4">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                Tính chất & Công thức
            </h5>
            <div class="row g-3">
                <div class="col-md-7">
                    <h6 class="fw-bold text-dark mb-2">Các tính chất quan trọng:</h6>
                    <ul class="list-group list-group-flush">
                        @foreach (var prop in Model.Lesson.Properties)
                        {
                            <li class="list-group-item px-0 py-2 text-dark bg-transparent">
                                • @prop
                            </li>
                        }
                    </ul>
                </div>
                <div class="col-md-5">
                    @if (Model.Lesson.Formulas.Any())
                    {
                        <div class="p-3 bg-primary bg-opacity-10 rounded-3 border border-primary-subtle h-100">
                            <h6 class="fw-bold text-primary mb-2">Công thức cần nhớ:</h6>
                            @foreach (var f in Model.Lesson.Formulas)
                            {
                                <div class="p-2 mb-2 bg-white rounded border fw-semibold text-dark small">
                                    @f
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Section 3: Ví dụ minh họa & Thực tiễn -->
        <div class="ylg-card p-4 mb-4">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                Ví dụ minh họa & Liên hệ thực tiễn
            </h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 h-100 border">
                        <strong class="d-block text-dark mb-1">Ví dụ toán học:</strong>
                        <p class="text-muted small mb-0">@Model.Lesson.VisualExample</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 h-100 border">
                        <strong class="d-block text-dark mb-1">Ứng dụng thực tiễn:</strong>
                        <p class="text-muted small mb-0">@Model.Lesson.RealWorldExample</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 4: Geometry Lab (Nếu có) -->
        @if (Model.Lesson.HasGeometryLab)
        {
            <div class="ylg-card p-4 mb-4" id="labSection">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                    <h5 class="fw-bold text-dark mb-0">
                        Geometry Lab
                    </h5>
                    <span class="badge bg-primary-subtle text-primary">Kéo 4 đỉnh A, B, C, D</span>
                </div>
                <p class="text-muted small mb-3">
                    Kéo các đỉnh để quan sát sự thay đổi góc và cạnh theo thời gian thực.
                </p>

                <div class="row g-3 align-items-center">
                    <div class="col-md-8">
                        <div class="lab-canvas-container" style="height: 340px;">
                            <svg id="lessonLabSvg" width="100%" height="340" viewBox="0 0 500 340" data-default-shape="@Model.Lesson.DefaultLabShape">
                                <defs>
                                    <pattern id="lessonGrid" width="20" height="20" patternUnits="userSpaceOnUse">
                                        <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#f1f5f9" stroke-width="1"/>
                                    </pattern>
                                </defs>
                                <rect width="500" height="340" fill="url(#lessonGrid)" />

                                <!-- Polygon -->
                                <polygon id="labPoly" class="lab-polygon" points="120,60 380,60 380,260 120,260" />
                                
                                <!-- Diagonals -->
                                <line id="labDiag1" class="lab-diagonal" x1="120" y1="60" x2="380" y2="260" />
                                <line id="labDiag2" class="lab-diagonal" x1="380" y1="60" x2="120" y2="260" />

                                <!-- Vertices -->
                                <circle id="ptA" class="lab-vertex" cx="120" cy="60" r="8" />
                                <text id="lblA" x="100" y="55" font-weight="bold" fill="#1e1b4b">A</text>

                                <circle id="ptB" class="lab-vertex" cx="380" cy="60" r="8" />
                                <text id="lblB" x="390" y="55" font-weight="bold" fill="#1e1b4b">B</text>

                                <circle id="ptC" class="lab-vertex" cx="380" cy="260" r="8" />
                                <text id="lblC" x="390" y="275" font-weight="bold" fill="#1e1b4b">C</text>

                                <circle id="ptD" class="lab-vertex" cx="120" cy="260" r="8" />
                                <text id="lblD" x="100" y="275" font-weight="bold" fill="#1e1b4b">D</text>
                            </svg>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="text-muted small d-block mb-1">Loại hình nhận diện:</span>
                            <h5 id="labDetectedShape" class="fw-bold text-primary mb-3">Hình chữ nhật</h5>

                            <div class="small text-muted mb-2">Độ dài cạnh:</div>
                            <div class="d-flex justify-content-between small mb-1">
                                <span>AB: <strong id="lenAB">260</strong></span>
                                <span>BC: <strong id="lenBC">200</strong></span>
                            </div>
                            <div class="d-flex justify-content-between small mb-3">
                                <span>CD: <strong id="lenCD">260</strong></span>
                                <span>DA: <strong id="lenDA">200</strong></span>
                            </div>

                            <div class="small text-muted mb-2">Góc tại đỉnh:</div>
                            <div class="d-flex justify-content-between small mb-1">
                                <span>Â: <strong id="angA">90°</strong></span>
                                <span>B̂: <strong id="angB">90°</strong></span>
                            </div>
                            <div class="d-flex justify-content-between small mb-3">
                                <span>Ĉ: <strong id="angC">90°</strong></span>
                                <span>D̂: <strong id="angD">90°</strong></span>
                            </div>

                            <button id="btnResetLab" class="btn btn-sm btn-outline-secondary w-100">
                                Khôi phục hình gốc
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Section 5: Bài tập thực hành -->
        @if (Model.Lesson.PracticeExercises.Any())
        {
            <div class="ylg-card p-4 mb-4">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                    Bài tập thực hành
                </h5>
                <p class="text-muted small mb-3">
                    Trả lời các câu hỏi bên dưới để củng cố kiến thức bài học.
                </p>

                @for (int i = 0; i < Model.Lesson.PracticeExercises.Count; i++)
                {
                    var ex = Model.Lesson.PracticeExercises[i];
                    <div class="practice-box" id="practiceBox_@ex.Id" data-attempt="0">
                        <h6 class="fw-bold text-dark mb-2">Câu @(i + 1): @ex.QuestionText</h6>

                        @if (ex.Type == "single_choice" && ex.Options.Any())
                        {
                            <div class="mb-3">
                                @foreach (var opt in ex.Options)
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="radio" name="opt_@ex.Id" id="opt_@(ex.Id)_@(opt.GetHashCode())" value="@opt">
                                        <label class="form-check-label text-dark" for="opt_@(ex.Id)_@(opt.GetHashCode())">
                                            @opt
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="mb-3" style="max-width: 260px;">
                                <input type="text" class="form-control" id="input_@ex.Id" placeholder="Nhập câu trả lời số...">
                            </div>
                        }

                        <button type="button" class="btn btn-sm btn-outline-primary px-3" onclick="submitPractice('@Model.Lesson.Id', '@ex.Id', '@ex.Type')">
                            Kiểm tra kết quả
                        </button>

                        <!-- Feedback Message -->
                        <div id="feedback_@ex.Id" class="mt-2 small fw-semibold" style="display:none;"></div>
                        <!-- Hint Banner -->
                        <div id="hint_@ex.Id" class="hint-banner" style="display:none;"></div>
                        <!-- Answer Explanation -->
                        <div id="expl_@ex.Id" class="p-2 bg-light rounded mt-2 small text-dark border" style="display:none;"></div>
                    </div>
                }
            </div>
        }

        <!-- Coursera-style Mark as Completed Button (Compact & Clean) -->
        <div class="p-3 my-4 bg-white rounded-3 border d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <strong class="d-block text-dark">Trạng thái bài học:</strong>
                <small class="text-muted">
                    @if (Model.CurrentStatus == "Completed")
                    {
                        <span class="text-success fw-semibold">✓ Bạn đã hoàn thành bài học này.</span>
                    }
                    else if (Model.Lesson.HasMiniTest)
                    {
                        <span>Nhấn xác nhận sau khi đọc bài, sau đó hoàn tất Mini Test bên dưới (đạt từ 75%) để hoàn thành.</span>
                    }
                    else
                    {
                        <span>Nhấn xác nhận sau khi bạn đã đọc hiểu nội dung bài học.</span>
                    }
                </small>
            </div>
            <div>
                @if (Model.CurrentStatus == "Completed")
                {
                    <button type="button" class="btn btn-success px-4 py-2 fw-semibold" disabled>
                        ✓ Đã hoàn thành
                    </button>
                }
                else
                {
                    <form asp-action="MarkCompleted" asp-route-id="@Model.Lesson.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold shadow-sm">
                            Xác nhận hoàn thành
                        </button>
                    </form>
                }
            </div>
        </div>

        <!-- Section 6: Mini Test (Nếu có) -->
        @if (Model.Lesson.HasMiniTest && Model.Lesson.MiniTest.Any())
        {
            <div class="ylg-card p-4 mb-4" id="miniTestSection">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                    <h5 class="fw-bold text-dark mb-0">
                        Mini Test (@Model.Lesson.MiniTest.Count câu)
                    </h5>
                    <div>
                        <span class="badge bg-warning text-dark">Ngưỡng đạt: 75%</span>
                        @if (Model.Progress?.BestMiniTestScore > 0)
                        {
                            <span class="badge bg-light text-dark border ms-1">
                                Điểm cao nhất: <strong>@Model.Progress.BestMiniTestScore%</strong>
                            </span>
                        }
                    </div>
                </div>
                <p class="text-muted small mb-4">
                    Làm bài kiểm tra ngắn để tự đánh giá mức độ tiếp thu bài học. Ngưỡng đạt từ 75% trở lên.
                </p>

                <form asp-action="SubmitMiniTest" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="LessonId" value="@Model.Lesson.Id" />

                    @for (int i = 0; i < Model.Lesson.MiniTest.Count; i++)
                    {
                        var q = Model.Lesson.MiniTest[i];
                        <div class="p-3 mb-3 border rounded-3 bg-white">
                            <h6 class="fw-bold text-dark mb-3">@q.QuestionText</h6>
                            <input type="hidden" name="Answers[@i].QuestionId" value="@q.Id" />
                            @foreach (var opt in q.Options)
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="Answers[@i].SelectedOption" id="test_@(q.Id)_@(opt.GetHashCode())" value="@opt" required>
                                    <label class="form-check-label text-dark" for="test_@(q.Id)_@(opt.GetHashCode())">
                                        @opt
                                    </label>
                                </div>
                            }
                        </div>
                    }

                    <div class="text-end mt-4">
                        <button type="submit" class="btn btn-ylg-primary px-4 py-2">
                            Nộp bài Mini Test
                        </button>
                    </div>
                </form>
            </div>
        }

        <!-- Bottom Navigation: Coursera "Go to next item" style -->
        <div class="d-flex flex-wrap justify-content-between align-items-center pt-3 border-top mt-4 gap-2">
            @if (Model.PreviousLesson != null)
            {
                <a asp-action="Detail" asp-route-id="@Model.PreviousLesson.Id" class="btn btn-outline-secondary px-3 py-2">
                    &larr; Bài trước: @Model.PreviousLesson.Title
                </a>
            }
            else
            {
                <div></div>
            }

            @if (Model.NextLesson != null)
            {
                <a asp-action="Detail" asp-route-id="@Model.NextLesson.Id" class="btn btn-ylg-primary px-4 py-2">
                    Bài tiếp theo: @Model.NextLesson.Title &rarr;
                </a>
            }
            else
            {
                <a asp-controller="Curriculum" asp-action="Index" class="btn btn-outline-primary px-4 py-2">
                    Hoàn tất lộ trình &rarr;
                </a>
            }
        </div>
        </div>
    </main>
</div>

@section Scripts {
    <script src="~/js/lesson-practice.js" asp-append-version="true"></script>
    @if (Model.Lesson.HasGeometryLab)
    {
        <script src="~/js/geometry-lab.js" asp-append-version="true"></script>
    }
    <script>
        // Coursera Sidebar Toggle (Clean Icon Button on Sidebar & Floating Dock Tab)
        const sidebar = document.getElementById('courseSidebarCol');
        const btnCollapse = document.getElementById('btnCollapseSidebar');
        const btnExpand = document.getElementById('btnExpandSidebar');

        function setSidebarState(collapsed) {
            if (!sidebar || !btnExpand) return;
            if (collapsed) {
                sidebar.classList.add('d-none');
                btnExpand.classList.remove('d-none');
                btnExpand.classList.add('d-flex');
                localStorage.setItem('ylg_course_sidebar_collapsed', 'true');
            } else {
                sidebar.classList.remove('d-none');
                btnExpand.classList.remove('d-flex');
                btnExpand.classList.add('d-none');
                localStorage.setItem('ylg_course_sidebar_collapsed', 'false');
            }
        }

        btnCollapse?.addEventListener('click', () => setSidebarState(true));
        btnExpand?.addEventListener('click', () => setSidebarState(false));

        // Restore user preference
        if (localStorage.getItem('ylg_course_sidebar_collapsed') === 'true') {
            setSidebarState(true);
        }

        // Module chevron indicators update
        document.querySelectorAll('.module-header').forEach(header => {
            header.addEventListener('click', function() {
                const icon = this.querySelector('.chevron-icon');
                const targetId = this.getAttribute('data-bs-target');
                const target = document.querySelector(targetId);
                setTimeout(() => {
                    if (target && target.classList.contains('show')) {
                        icon.innerText = '▲';
                    } else {
                        icon.innerText = '▼';
                    }
                }, 350);
            });
        });
    </script>
